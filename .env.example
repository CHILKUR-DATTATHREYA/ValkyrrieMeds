# Valkyrrie Meds Email Configuration (Optional - for live inbox delivery)
# To send live emails from valkyrriemeds@gmail.com:
# 1. Enable 2-Step Verification on valkyrriemeds@gmail.com
# 2. Go to Google Account > Security > App Passwords > Create "Valkyrrie Meds Website"
# 3. Enter the 16-character generated app password below:

GMAIL_USER=valkyrriemeds@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Or use standard SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=valkyrriemeds@gmail.com
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# Google OAuth Configuration (Optional - to connect custom Google Cloud OAuth App)
# In Google Cloud Console > Credentials > OAuth 2.0 Client IDs:
# Add Authorized Redirect URI: http://localhost:3000/auth/callback (and https://valkyrriemeds.com/auth/callback)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# LinkedIn OAuth Configuration (Optional - to connect LinkedIn Developer App)
# In LinkedIn Developer Portal > Auth > Redirect URLs:
# Add Authorized Redirect URL: http://localhost:3000/auth/callback (and https://valkyrriemeds.com/auth/callback)
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id
